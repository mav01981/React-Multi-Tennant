<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for Identity.API (matches ../../Identity.API). -->
  <PropertyGroup>
    <RootNamespace>Identity.Api.UnitTests</RootNamespace>
  </PropertyGroup>

  <!-- Tests exercise ASP.NET Core primitives directly (HttpContext,
       ApplicationBuilder). These come from the shared framework, which the
       plain Sdk does not reference; declare it explicitly instead of relying
       on the reference flowing transitively from Identity.API. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Identity.API\Identity.API.csproj" />
    <ProjectReference Include="..\Identity.TestSupport\Identity.TestSupport.csproj" />
  </ItemGroup>

</Project>